# Local development only; never enable in production.
GALAPAGOS_LOCAL_MODE=1
APP_ORIGIN=http://127.0.0.1:3000
# Production: GALAPAGOS_LOCAL_MODE=0 and set all three values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATA_ENCRYPTION_KEY=
# Google OAuth web client; redirect must be APP_ORIGIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Daily sync scheduler uses a strong random key (32+ characters).
CRON_SECRET=
# Server-only, required for production daily jobs. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
